{
  "extends": "../tsconfig.base.json",
  // the examples are ES modules a bundler serves, and the examples browser reaches the
  // shell, which is .tsx
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve"
  },
  "include": ["./**/*.ts"]
}
