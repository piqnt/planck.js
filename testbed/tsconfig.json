{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve",
    "paths": {
      "planck": ["../src/main.ts"],
      "planck/testbed": ["./index.ts"],
      "planck/testbed/*": ["./*"],
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/**/*.ts"],
  "exclude": ["node_modules"]
}
